# Copy to .env before: docker compose up --build
# Generate a strong JWT_SECRET for local use only; never commit .env

JWT_SECRET=generate-a-local-secret-min-32-chars
MONGODB_URI=mongodb://mongo:27017/easygenerator_auth
CORS_ORIGIN=http://localhost:8080
PORT=3000
JWT_EXPIRES_IN=1h
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# Baked into the frontend image at build time (browser calls host port 3000)
VITE_API_URL=http://localhost:3000/api
